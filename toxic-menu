nginx_v2ray_proxy() {
    header "⚙️  Configure Nginx for V2Ray"
    local DOMAIN=$(get_domain)
    if [ -z "$DOMAIN" ]; then
        error "Set domain first!"
        return
    fi
    if [ ! -f "${CERT_DIR}/fullchain.pem" ]; then
        error "Generate SSL certificate first!"
        return
    fi

    cat > /etc/nginx/sites-available/v2ray << NGINXCONF
server {
    listen 80;
    server_name ${DOMAIN};
    return 301 https://\$host\$request_uri;
}

server {
    listen 443 ssl http2;
    server_name ${DOMAIN};

    ssl_certificate     ${CERT_DIR}/fullchain.pem;
    ssl_certificate_key ${CERT_DIR}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # Websocket path for V2Ray
    location /v2ray-ws {
        proxy_redirect off;
        proxy_pass http://127.0.0.1:2083;
        proxy_http_version 1.1;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
    }

    # gRPC for V2Ray
    location /toxic-grpc {
        grpc_pass grpc://127.0.0.1:10000;
        grpc_set_header X-Real-IP \$remote_addr;
    }

    # Default page (camouflage)
    location / {
        root /var/www/html;
        index index.html;
    }
}
NGINXCONF

    ln -sf /etc/nginx/sites-available/v2ray /etc/nginx/sites-enabled/
    rm -f /etc/nginx/sites-enabled/default
    nginx -t 2>/dev/null && systemctl restart nginx
    success "Nginx configured as V2Ray reverse proxy!"
}

