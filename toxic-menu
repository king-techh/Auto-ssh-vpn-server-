install_v2ray() {
    header "📦 Installing V2Ray"
    info "Downloading V2Ray install script..."

    # Official V2Ray installer
    bash <(curl -L https://raw.githubusercontent.com/v2fly/fhs-install-v2ray/master/install-release.sh) 2>/dev/null

    if [ $? -eq 0 ]; then
        systemctl enable v2ray
        systemctl start v2ray
        success "V2Ray installed successfully!"
    else
        error "V2Ray installation failed!"
    fi
}

create_vmess() {
    header "🔵 Create VMess Account"
    local DOMAIN=$(get_domain)
    local IP=$(get_ip)
    local UUID=$(cat /proc/sys/kernel/random/uuid)
    local PORT=${V2RAY_PORT}

    read -p $'  \033[1;33mPort (default 10000): \033[0m' custom_port
    PORT=${custom_port:-$V2RAY_PORT}

    read -p $'  \033[1;33mNetwork type [ws/tcp] (default ws): \033[0m' network
    network=${network:-ws}

    # Generate V2Ray config
    cat > /usr/local/etc/v2ray/config.json << VMCONF
{
  "inbounds": [{
    "port": ${PORT},
    "protocol": "vmess",
    "settings": {
      "clients": [{ "id": "${UUID}", "alterId": 0 }]
    },
    "streamSettings": {
      "network": "${network}",
      "wsSettings": { "path": "/vmess" }
    }
  }],
  "outbounds": [{ "protocol": "freedom" }]
}
VMCONF

    systemctl restart v2ray 2>/dev/null
    echo "v2ray|vmess|${UUID}|${PORT}|${network}|$(date +%Y-%m-%d)" >> "$TOXIC_DB"

    # Generate vmess link
    local VMESS_RAW="{\"v\":\"2\",\"ps\":\"TOXIC-VMess\",\"add\":\"${IP}\",\"port\":\"${PORT}\",\"id\":\"${UUID}\",\"aid\":\"0\",\"net\":\"${network}\",\"type\":\"none\",\"host\":\"\",\"path\":\"/vmess\",\"tls\":\"\"}"
    local VMESS_LINK="vmess://$(echo -n "$VMESS_RAW" | base64 -w 0)"

    echo ""
    echo -e "${GREEN_B}  ✅ VMess Account Created!${RST}"
    separator
    echo -e "  ${WHITE}UUID:${RST}     ${GREEN_B}${UUID}${RST}"
    echo -e "  ${WHITE}Port:${RST}     ${GREEN_B}${PORT}${RST}"
    echo -e "  ${WHITE}Network:${RST}   ${GREEN_B}${network}${RST}"
    echo -e "  ${WHITE}Path:${RST}      ${GREEN_B}/vmess${RST}"
    echo ""
    echo -e "  ${CYAN_B}V2Ray Link:${RST}"
    echo -e "  ${YELLOW}${VMESS_LINK}${RST}"
}

create_vless() {
    header "🟢 Create VLESS Account"
    local DOMAIN=$(get_domain)
    local IP=$(get_ip)
    local UUID=$(cat /proc/sys/kernel/random/uuid)
    local PORT=443

    read -p $'  \033[1;33mPort (default 443): \033[0m' custom_port
    PORT=${custom_port:-443}

    cat > /usr/local/etc/v2ray/config.json << VLCONF
{
  "inbounds": [{
    "port": ${PORT},
    "protocol": "vless",
    "settings": {
      "clients": [{ "id": "${UUID}", "flow": "xtls-rprx-vision" }],
      "decryption": "none"
    },
    "streamSettings": {
      "network": "tcp",
      "security": "tls",
      "tlsSettings": {
        "certificates": [{
          "certificateFile": "${CERT_DIR}/fullchain.pem",
          "keyFile": "${CERT_DIR}/privkey.pem"
        }]
      }
    }
  }],
  "outbounds": [{ "protocol": "freedom" }]
}
VLCONF

    systemctl restart v2ray 2>/dev/null
    echo "v2ray|vless|${UUID}|${PORT}|tcp|$(date +%Y-%m-%d)" >> "$TOXIC_DB"

    local VLESS_LINK="vless://${UUID}@${IP}:${PORT}?security=tls&type=tcp&flow=xtls-rprx-vision&headerType=none&sni=${DOMAIN}#TOXIC-VLESS"

    echo ""
    echo -e "${GREEN_B}  ✅ VLESS Account Created!${RST}"
    separator
    echo -e "  ${WHITE}UUID:${RST}     ${GREEN_B}${UUID}${RST}"
    echo -e "  ${WHITE}Port:${RST}     ${GREEN_B}${PORT}${RST}"
    echo -e "  ${WHITE}TLS:${RST}      ${GREEN_B}Enabled${RST}"
    echo ""
    echo -e "  ${CYAN_B}VLESS Link:${RST}"
    echo -e "  ${YELLOW}${VLESS_LINK}${RST}"
}

create_v2ray_ws_tls() {
    header "🔒 Create V2Ray + WS + TLS"
    local DOMAIN=$(get_domain)
    local IP=$(get_ip)
    local UUID=$(cat /proc/sys/kernel/random/uuid)

    if [ -z "$DOMAIN" ]; then
        error "Set up a domain first (Main Menu > 6)!"
        return
    fi

    if [ ! -f "${CERT_DIR}/fullchain.pem" ]; then
        error "SSL certificate not found! Install SSL first (Main Menu > 5)!"
        return
    fi

    read -p $'  \033[1;33mWS Port (default 443): \033[0m' ws_port
    ws_port=${ws_port:-443}

    cat > /usr/local/etc/v2ray/config.json << WSCONF
{
  "inbounds": [{
    "port": ${ws_port},
    "protocol": "vmess",
    "settings": {
      "clients": [{ "id": "${UUID}", "alterId": 0 }]
    },
    "streamSettings": {
      "network": "ws",
      "security": "tls",
      "wsSettings": { "path": "/v2ray-ws" },
      "tlsSettings": {
        "certificates": [{
          "certificateFile": "${CERT_DIR}/fullchain.pem",
          "keyFile": "${CERT_DIR}/privkey.pem"
        }]
      }
    }
  }],
  "outbounds": [{ "protocol": "freedom" }]
}
WSCONF

    systemctl restart v2ray 2>/dev/null
    echo "v2ray|vmess-ws-tls|${UUID}|${ws_port}|ws-tls|$(date +%Y-%m-%d)" >> "$TOXIC_DB"

    local VMESS_RAW="{\"v\":\"2\",\"ps\":\"TOXIC-WS-TLS\",\"add\":\"${DOMAIN}\",\"port\":\"${ws_port}\",\"id\":\"${UUID}\",\"aid\":\"0\",\"net\":\"ws\",\"type\":\"none\",\"host\":\"${DOMAIN}\",\"path\":\"/v2ray-ws\",\"tls\":\"tls\"}"
    local VMESS_LINK="vmess://$(echo -n "$VMESS_RAW" | base64 -w 0)"

    echo ""
    echo -e "${GREEN_B}  ✅ V2Ray WS+TLS Account Created!${RST}"
    separator
    echo -e "  ${WHITE}UUID:${RST}     ${GREEN_B}${UUID}${RST}"
    echo -e "  ${WHITE}Port:${RST}     ${GREEN_B}${ws_port}${RST}"
    echo -e "  ${WHITE}Network:${RST}   ${GREEN_B}ws + tls${RST}"
    echo -e "  ${WHITE}Domain:${RST}   ${GREEN_B}${DOMAIN}${RST}"
    echo -e "  ${WHITE}Path:${RST}      ${GREEN_B}/v2ray-ws${RST}"
    echo ""
    echo -e "  ${CYAN_B}V2Ray Link:${RST}"
    echo -e "  ${YELLOW}${VMESS_LINK}${RST}"
}

create_v2ray_grpc() {
    header "⚡ Create V2Ray + gRPC"
    local DOMAIN=$(get_domain)
    local IP=$(get_ip)
    local UUID=$(cat /proc/sys/kernel/random/uuid)
    local GRPC_NAME="toxic-grpc"

