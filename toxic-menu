install_certbot() {
    header "📦 Installing Certbot"
    if [ "$OS_ID" = "ubuntu" ] || [ "$OS_ID" = "debian" ]; then
        apt-get update -qq && apt-get install -y -qq certbot
    else
        yum install -y -q certbot 2>/dev/null || dnf install -y -q certbot
    fi
    success "Certbot installed!"
}

generate_ssl() {
    header "🔐 Generate SSL Certificate"
    local DOMAIN=$(get_domain)
    if [ -z "$DOMAIN" ]; then
        error "Set up a domain first! (Main Menu > 6)"
        return
    fi

    info "Generating SSL for ${DOMAIN}..."
    certbot certonly --standalone -d "$DOMAIN" --non-interactive --agree-tos --email admin@${DOMAIN}

    # Copy to toxic dir
    cp -f /etc/letsencrypt/live/${DOMAIN}/fullchain.pem "${CERT_DIR}/" 2>/dev/null
    cp -f /etc/letsencrypt/live/${DOMAIN}/privkey.pem "${CERT_DIR}/" 2>/dev/null

    # Auto-renew cron
    (crontab -l 2>/dev/null; echo "0 0 * * * certbot renew --quiet && cp /etc/letsencrypt/live/${DOMAIN}/*.pem ${CERT_DIR}/") | sort -u | crontab -

    success "SSL certificate generated for ${DOMAIN}!"
    info "Cert: ${CERT_DIR}/fullchain.pem"
    info "Key:  ${CERT_DIR}/privkey.pem"
}

generate_self_signed() {
    header "🔐 Generate Self-Signed SSL"
    local DOMAIN=$(get_domain)
    DOMAIN=${DOMAIN:-$(get_ip)}

    openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
        -keyout "${CERT_DIR}/privkey.pem" \
        -out "${CERT_DIR}/fullchain.pem" \
        -subj "/CN=${DOMAIN}/O=TOXIC-VPN/C=KE" 2>/dev/null

    success "Self-signed SSL generated for ${DOMAIN}!"
    warn "Note: Self-signed certs will show browser warnings."
}

renew_ssl() {
    header "🔄 Renewing SSL"
    certbot renew --quiet
    local DOMAIN=$(get_domain)
    if [ -n "$DOMAIN" ]; then
        cp -f /etc/letsencrypt/live/${DOMAIN}/fullchain.pem "${CERT_DIR}/" 2>/dev/null
        cp -f /etc/letsencrypt/live/${DOMAIN}/privkey.pem "${CERT_DIR}/" 2>/dev/null
    fi
    success "SSL renewed!"
}

view_ssl_info() {
    header "📋 SSL Certificate Info"
    if [ -f "${CERT_DIR}/fullchain.pem" ]; then
        openssl x509 -in "${CERT_DIR}/fullchain.pem" -noout -subject -dates -issuer 2>/dev/null
    else
        warn "No SSL certificate found!"
    fi
}

