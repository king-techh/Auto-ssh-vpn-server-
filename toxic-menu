set_expiry() {
    header "⏰ Set Account Expiry"
    read -p $'  \033[1;33mUsername: \033[0m' username
    read -p $'  \033[1;33mDays until expiry: \033[0m' days
    if id "$username" &>/dev/null; then
        chage -M "$days" "$username"
        success "Account '${username}' expires in ${days} days!"
    else
        error "User not found!"
    fi
}

lock_unlock() {
    header "🔒 Lock/Unlock Account"
    read -p $'  \033[1;33mUsername: \033[0m' username
    if ! id "$username" &>/dev/null; then
        error "User not found!"
        return
