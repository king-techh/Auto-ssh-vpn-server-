export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# ─── Color Definitions ────────────────────────────────────────
RST='\033[0m'; BOLD='\033[1m'; DIM='\033[2m'
RED='\033[0;31m'; RED_B='\033[1;31m'
GREEN='\033[0;32m'; GREEN_B='\033[1;32m'
YELLOW='\033[0;33m'; YELLOW_B='\033[1;33m'
BLUE='\033[0;34m'; BLUE_B='\033[1;34m'
CYAN='\033[0;36m'; CYAN_B='\033[1;36m'
MAGENTA='\033[0;35m'; MAGENTA_B='\033[1;35m'
WHITE='\033[1;37m'; ORANGE='\033[38;5;202m'

# ─── Config ───────────────────────────────────────────────────
TOXIC_DIR="/etc/toxic-vpn"
TOXIC_LOG="/var/log/toxic-vpn"
TOXIC_DB="${TOXIC_DIR}/accounts.db"
DOMAIN_FILE="${TOXIC_DIR}/domain.conf"
CERT_DIR="${TOXIC_DIR}/ssl"
SETTINGS_FILE="${TOXIC_DIR}/settings.conf"

SSH_PORT=22
DROPBEAR_PORT=443
V2RAY_PORT=10000
V2RAY_WS_PORT=2083
SSL_PORT=443
OPENVPN_PORT=1194

# ─── Create directories ──────────────────────────────────────
mkdir -p "$TOXIC_DIR" "$TOXIC_LOG" "$CERT_DIR" 2>/dev/null

# ─── Utility Functions ────────────────────────────────────────
info()    { echo -e "  ${BLUE_B}[INFO]${RST}    $1"; }
success() { echo -e "  ${GREEN_B}[OK]${RST}      $1"; }
warn()    { echo -e "  ${YELLOW_B}[WARN]${RST}    $1"; }
error()   { echo -e "  ${RED_B}[ERROR]${RST}   $1"; }

separator() {
    echo -e "${DIM}  ──────────────────────────────────────────────${RST}"
}

header() {
    echo ""
    echo -e "${CYAN_B}  ╔═══════════════════════════════════════════╗${RST}"
    echo -e "${CYAN_B}  ║${RST} ${WHITE}$1${RST}"
    echo -e "${CYAN_B}  ╚═══════════════════════════════════════════╝${RST}"
    echo ""
}

press_enter() {
    echo ""
    read -n 1 -s -r -p $'\n  \033[1;33mPress ENTER to continue...\033[0m'
}

# ─── Check Root ───────────────────────────────────────────────
check_root() {
    if [[ $EUID -ne 0 ]]; then
        error "Run as root: sudo toxic-menu"
        exit 1
    fi
}

# ─── Detect OS ────────────────────────────────────────────────
detect_os() {
    if [ -f /etc/os-release ]; then
        . /etc/os-release
        OS_ID=$ID
    else
        OS_ID="unknown"
    fi
}

# ─── Get Server IP ────────────────────────────────────────────
get_ip() {
    curl -s ifconfig.me 2>/dev/null || ip -4 addr show eth0 2>/dev/null | grep -oP '(?<=inet\s)\d+(\.\d+){3}' | head -1
}

# ─── Get Domain ───────────────────────────────────────────────
get_domain() {
    if [ -f "$DOMAIN_FILE" ]; then
        cat "$DOMAIN_FILE"
    else
        echo ""
    fi
}

