    if [ ! -f "$TOXIC_DB" ] || [ ! -s "$TOXIC_DB" ]; then
        warn "No accounts found!"
        return
    fi

    if [ "$filter" = "all" ]; then
        echo -e "  ${CYAN_B}Type         Username       Created${RST}"
        separator
        while IFS='|' read -r type user pass date; do
            printf "  %-12s %-14s %s\n" "$type" "$user" "$date"
        done < "$TOXIC_DB"
    else
        echo -e "  ${CYAN_B}Type         Username       Created${RST}"
        separator
        grep "^${filter}|" "$TOXIC_DB" | while IFS='|' read -r type user pass date; do
            printf "  %-12s %-14s %s\n" "$type" "$user" "$date"
        done
        if [ $? -ne 0 ]; then
