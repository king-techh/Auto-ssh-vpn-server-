# ═══════════════════════════════════════════════════════════════
#  SSH MENU
# ═══════════════════════════════════════════════════════════════
ssh_menu() {
    while true; do
        show_banner
        header "🔐 SSH MENU"
        echo -e "  ${GREEN_B}1)${RST} ${WHITE}Install OpenSSH Server${RST}"
        echo -e "  ${GREEN_B}2)${RST} ${WHITE}Configure SSH Port${RST}"
        echo -e "  ${GREEN_B}3)${RST} ${WHITE}Create SSH Account${RST}"
        echo -e "  ${GREEN_B}4)${RST} ${WHITE}Delete SSH Account${RST}"
        echo -e "  ${GREEN_B}5)${RST} ${WHITE}List SSH Accounts${RST}"
        echo -e "  ${GREEN_B}6)${RST} ${WHITE}SSH Speed Limit${RST}"
        echo -e "  ${GREEN_B}7)${RST} ${WHITE}Restart SSH${RST}"
        echo -e "  ${RED_B}0)${RST} ${WHITE}Back${RST}"
        echo ""
        read -p $'  \033[1;36mSelect: \033[0m' ch

        case "$ch" in
            1) install_ssh ;;
            2) config_ssh_port ;;
            3) create_ssh_account ;;
            4) delete_ssh_account ;;
            5) list_accounts "ssh" ;;
            6) ssh_speed_limit ;;
            7) systemctl restart ssh 2>/dev/null || systemctl restart sshd; success "SSH restarted!" ;;
            0) break ;;
            *) warn "Invalid!"; sleep 1 ;;
        esac
        press_enter
    done
}

install_ssh() {
    header "📦 Installing OpenSSH"
    if [ "$OS_ID" = "ubuntu" ] || [ "$OS_ID" = "debian" ]; then
        apt-get update -qq && apt-get install -y -qq openssh-server
    else
        yum install -y -q openssh-server 2>/dev/null || dnf install -y -q openssh-server
    fi
    systemctl enable ssh 2>/dev/null || systemctl enable sshd
    systemctl start ssh 2>/dev/null || systemctl start sshd
    success "OpenSSH installed and running on port ${SSH_PORT}!"
}

config_ssh_port() {
    header "⚙️  Configure SSH Port"
    read -p $'  \033[1;33mEnter new SSH port: \033[0m' new_port
    if [[ "$new_port" =~ ^[0-9]+$ ]] && [ "$new_port" -ge 1 ] && [ "$new_port" -le 65535 ]; then
        sed -i "s/^#*Port .*/Port ${new_port}/" /etc/ssh/sshd_config
        systemctl restart ssh 2>/dev/null || systemctl restart sshd
        SSH_PORT=$new_port
        echo "SSH_PORT=${SSH_PORT}" > "${TOXIC_DIR}/ssh_port.conf"
        success "SSH port changed to ${new_port}!"
    else
        error "Invalid port number!"
    fi
}

create_ssh_account() {
    header "👤 Create SSH Account"
    read -p $'  \033[1;33mUsername: \033[0m' username
    read -s -p $'  \033[1;33mPassword: \033[0m' password
    echo ""

    if [ -z "$username" ] || [ -z "$password" ]; then
        error "Username and password required!"
        return
    fi

    if id "$username" &>/dev/null; then
        echo "$username:$password" | chpasswd
        warn "User exists — password updated!"
    else
        useradd -m -s /bin/bash "$username"
        echo "$username:$password" | chpasswd
    fi

    # Save to toxic accounts db
    echo "ssh|${username}|${password}|$(date +%Y-%m-%d)" >> "$TOXIC_DB"
    success "SSH account '${username}' created!"
}

delete_ssh_account() {
    header "🗑️  Delete SSH Account"
    read -p $'  \033[1;33mUsername to delete: \033[0m' username
    if id "$username" &>/dev/null; then
        userdel -r "$username" 2>/dev/null
        sed -i "/^ssh|${username}|/d" "$TOXIC_DB"
        success "Account '${username}' deleted!"
    else
        error "User not found!"
    fi
}

ssh_speed_limit() {
    header "⚡ SSH Speed Limit"
    echo -e "  ${WHITE}1)${RST} 1 Mbps"
    echo -e "  ${WHITE}2)${RST} 5 Mbps"
    echo -e "  ${WHITE}3)${RST} 10 Mbps"
    echo -e "  ${WHITE}4)${RST} Unlimited"
    read -p $'  \033[1;36mSelect: \033[0m' speed
    # Using trickle or tc for rate limiting — store config
    local rate=""
    case "$speed" in
        1) rate="1mbit" ;;
        2) rate="5mbit" ;;
        3) rate="10mbit" ;;
        4) rate="" ;;
        *) warn "Invalid!"; return ;;
    esac
    echo "SSH_SPEED_LIMIT=${rate}" > "${TOXIC_DIR}/ssh_speed.conf"
    success "Speed limit set!"
}

