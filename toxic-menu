    echo -e "  ${WHITE}Domain:${RST}        ${GREEN_B}${DOMAIN_DISPLAY}${RST}"
    echo ""
    echo -e "  ${WHITE}Active Connections:${RST}"
    echo -e "  ${WHITE}SSH:${RST}           ${GREEN_B}$(ss -tnp | grep ":${SSH_PORT}" | wc -l)${RST}"
    echo -e "  ${WHITE}Dropbear:${RST}      ${GREEN_B}$(ss -tnp | grep ":${DROPBEAR_PORT}" | wc -l)${RST}"
    echo -e "  ${WHITE}V2Ray:${RST}         ${GREEN_B}$(ss -tnp | grep ":${V2RAY_PORT}" | wc -l)${RST}"
    echo ""
    echo -e "  ${WHITE}Bandwidth (this month):${RST}"
    local RX=$(cat /sys/class/net/$(ip route | awk '/default/ {print $5}' | head -1)/statistics/rx_bytes 2>/dev/null)
    local TX=$(cat /sys/class/net/$(ip route | awk '/default/ {print $5}' | head -1)/statistics/tx_bytes 2>/dev/null)
    echo -e "  ${WHITE}Download:${RST}      ${GREEN_B}$(( RX / 1024 / 1024 )) MB${RST}"
    echo -e "  ${WHITE}Upload:${RST}        ${GREEN_B}$(( TX / 1024 / 1024 )) MB${RST}"
}

# ═══════════════════════════════════════════════════════════════
#  AUTO INSTALL ALL
# ═══════════════════════════════════════════════════════════════
auto_install() {
    show_banner
    header "⚡ AUTO INSTALL ALL SERVICES"
    echo -e "  ${YELLOW_B}This will install:${RST}"
    echo -e "  ${GREEN_B}✓${RST} OpenSSH Server"
    echo -e "  ${GREEN_B}✓${RST} Dropbear"
    echo -e "  ${GREEN_B}✓${RST} V2Ray"
    echo -e "  ${GREEN_B}✓${RST} Nginx"
    echo -e "  ${GREEN_B}✓${RST} Certbot"
    echo -e "  ${GREEN_B}✓${RST} Fail2Ban"
    echo -e "  ${GREEN_B}✓${RST} UFW Firewall"
    echo ""
    read -p $'  \033[1;36mProceed? [Y/n]: \033[0m' confirm
    if [[ "$confirm" == [Nn] ]]; then return; fi

    # Install packages
    info "Installing packages..."
    if [ "$OS_ID" = "ubuntu" ] || [ "$OS_ID" = "debian" ]; then
        apt-get update -qq
        apt-get install -y -qq openssh-server dropbear nginx certbot fail2ban ufw
    else
        yum install -y -q openssh-server dropbear nginx certbot fail2ban ufw 2>/dev/null || \
        dnf install -y -q openssh-server dropbear nginx certbot fail2ban ufw
    fi

    # Configure Dropbear
    sed -i 's/NO_START=1/NO_START=0/' /etc/default/dropbear 2>/dev/null
    systemctl enable dropbear ssh nginx fail2ban 2>/dev/null
    systemctl start dropbear ssh nginx fail2ban 2>/dev/null

    # Install V2Ray
    info "Installing V2Ray..."
    bash <(curl -L https://raw.githubusercontent.com/v2fly/fhs-install-v2ray/master/install-release.sh) 2>/dev/null

    # UFW
    ufw default deny incoming > /dev/null 2>&1
    ufw default allow outgoing > /dev/null 2>&1
    ufw allow 22/tcp > /dev/null 2>&1
    ufw allow 80/tcp > /dev/null 2>&1
    ufw allow 443/tcp > /dev/null 2>&1
    ufw allow 443/udp > /dev/null 2>&1
    ufw allow 10000:20000/tcp > /dev/null 2>&1
    echo "y" | ufw enable > /dev/null 2>&1

    # Create default admin account
    local ADMIN_USER="toxicadmin"
    local ADMIN_PASS=$(openssl rand -base64 12)
    useradd -m -s /bin/bash "$ADMIN_USER" 2>/dev/null
    echo "$ADMIN_USER:$ADMIN_PASS" | chpasswd

    echo "ssh|${ADMIN_USER}|${ADMIN_PASS}|$(date +%Y-%m-%d)" >> "$TOXIC_DB"
    echo "dropbear|${ADMIN_USER}|${ADMIN_PASS}|$(date +%Y-%m-%d)" >> "$TOXIC_DB"

    echo ""
    echo -e "${GREEN_B}  ╔════════════════════════════════════════╗${RST}"
    echo -e "${GREEN_B}  ║   ✅ ALL SERVICES INSTALLED! ✅        ║${RST}"
    echo -e "${GREEN_B}  ╚════════════════════════════════════════╝${RST}"
    echo ""
    echo -e "  ${WHITE}Admin User:${RST}    ${GREEN_B}${ADMIN_USER}${RST}"
    echo -e "  ${WHITE}Admin Pass:${RST}    ${GREEN_B}${ADMIN_PASS}${RST}"
    echo -e "  ${WHITE}SSH Port:${RST}      ${GREEN_B}22${RST}"
    echo -e "  ${WHITE}Dropbear Port:${RST}  ${GREEN_B}443${RST}"
    echo -e "  ${WHITE}V2Ray Port:${RST}     ${GREEN_B}10000${RST}"
    echo ""
    echo -e "  ${YELLOW_B}Next: Set domain (Menu 6) + SSL (Menu 5)${RST}"
}

