    echo -e "  ${WHITE}Domain:${RST}  ${GREEN_B}${DOMAIN_DISPLAY}${RST}"
    echo -e "  ${WHITE}SSH:${RST}     ${SSH_STATUS}  ${WHITE}Dropbear:${RST} ${DROPBEAR_STATUS}"
    echo -e "  ${WHITE}V2Ray:${RST}   ${V2RAY_STATUS}  ${WHITE}OpenVPN:${RST}  ${OPENVPN_STATUS}"
    echo -e "${DIM}  ──────────────────────────────────────────────${RST}"
}

