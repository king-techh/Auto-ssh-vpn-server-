        echo -e "  ${GREEN_B}4)${RST} ${WHITE}Renew SSL Certificate${RST}"
        echo -e "  ${GREEN_B}5)${RST} ${WHITE}View SSL Info${RST}"
        echo -e "  ${RED_B}0)${RST} ${WHITE}Back${RST}"
        echo ""
        read -p $'  \033[1;36mSelect: \033[0m' ch

        case "$ch" in
            1) install_certbot ;;
            2) generate_ssl ;;
            3) generate_self_signed ;;
            4) renew_ssl ;;
            5) view_ssl_info ;;
            0) break ;;
            *) warn "Invalid!"; sleep 1 ;;
        esac
        press_enter
    done
