    local IP=$(get_ip)
    local DOMAIN=$(get_domain)
    local DOMAIN_DISPLAY=$([ -n "$DOMAIN" ] && echo "$DOMAIN" || echo "Not Set")

    # Check service status
    local SSH_STATUS=$(/usr/sbin/sshd -t 2>/dev/null && echo "${GREEN_B}ON${RST}" || echo "${RED_B}OFF${RST}")
    local DROPBEAR_STATUS=$(pgrep dropbear > /dev/null 2>&1 && echo "${GREEN_B}ON${RST}" || echo "${RED_B}OFF${RST}")
    local V2RAY_STATUS=$(pgrep v2ray > /dev/null 2>&1 && echo "${GREEN_B}ON${RST}" || echo "${RED_B}OFF${RST}")
    local OPENVPN_STATUS=$(pgrep openvpn > /dev/null 2>&1 && echo "${GREEN_B}ON${RST}" || echo "${RED_B}OFF${RST}")

    echo -e "${DIM}  ──────────────────────────────────────────────${RST}"
